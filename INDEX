<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>NFC Business Card Manager</title>

    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->

    <link
        rel="stylesheet"
        href="css/style.css">

</head>

<body>

<div class="container py-5">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                NFC Business Card Manager
            </h2>

            <p class="text-muted mb-0">
                Local Contact Management
            </p>

        </div>

        <button
            class="btn btn-primary"
            id="btnNew">

            <i class="bi bi-plus-circle"></i>

            New Contact

        </button>

    </div>

    <!-- Toolbar -->

    <div class="row mb-4">

        <div class="col-lg-8">

            <input
                id="searchBox"
                class="form-control"

                placeholder="Search contact...">

        </div>

        <div class="col-lg-4 text-end">

            <button
                class="btn btn-outline-success"
                id="btnImport">

                Import

            </button>

            <button
                class="btn btn-outline-primary"
                id="btnExport">

                Export

            </button>

        </div>

    </div>

    <!-- Contact List -->

    <div
        class="row"
        id="contactList">

    </div>

</div>

<!-- Modal -->

<div
class="modal fade"
id="contactModal">

<div class="modal-dialog modal-lg">

<div class="modal-content">

<div class="modal-header">

<h5>Create Contact</h5>

<button
class="btn-close"
data-bs-dismiss="modal">

</button>

</div>

<div class="modal-body">

<form id="contactForm">

<div class="row">

<div class="col-md-6 mb-3">

<label>Full Name</label>

<input
class="form-control"
id="fullname"
required>

</div>

<div class="col-md-6 mb-3">

<label>Company</label>

<input
class="form-control"
id="company">

</div>

<div class="col-md-6 mb-3">

<label>Department</label>

<input
class="form-control"
id="department">

</div>

<div class="col-md-6 mb-3">

<label>Job Title</label>

<input
class="form-control"
id="title">

</div>

<div class="col-md-6 mb-3">

<label>Phone</label>

<input
class="form-control"
id="phone">

</div>

<div class="col-md-6 mb-3">

<label>Email</label>

<input
type="email"
class="form-control"
id="email">

</div>

<div class="col-md-6 mb-3">

<label>Website</label>

<input
class="form-control"
id="website">

</div>

<div class="col-md-6 mb-3">

<label>LinkedIn</label>

<input
class="form-control"
id="linkedin">

</div>

<div class="col-12 mb-3">

<label>Avatar</label>

<input
type="file"
accept="image/*"
class="form-control"
id="avatar">

</div>

<div class="col-12">

<button
class="btn btn-success w-100"
type="submit">

Save Contact

</button>

</div>

</div>

</form>

</div>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script src="js/utils.js"></script>
<script src="js/vcard.js"></script>
<script src="js/app.js"></script>

</body>

</html>
